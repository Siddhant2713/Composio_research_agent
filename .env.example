# Gemini API key (AI Studio). Required.
GEMINI_API_KEY=

# Optional: comma-separated model fallback chain, most-preferred first.
# Free-tier quota and 503 "model overloaded" are both per-model, so the pipeline walks
# this chain. Leave unset to use the built-in default chain.
GEMINI_MODELS=

# Groq key for the adversarial verification pass (agent/audit.py). Optional: that pass is a
# cheap, high-volume yes/no judgement, so running it on Groq keeps it off the Gemini quota.
# Left unset, the audit falls back to Gemini.
GROQ_API_KEY=
GROQ_MODEL=

# Optional fetch tuning
AGENT_REQUEST_TIMEOUT_SECONDS=25
