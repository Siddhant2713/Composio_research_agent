{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppRecord",
  "description": "Research record for a single Composio app. Any field the fetched pages did not support must be null, with confidence 'low'.",
  "type": "object",
  "required": [
    "number",
    "name",
    "category",
    "one_liner",
    "auth",
    "access",
    "api_surface",
    "mcp",
    "buildability",
    "evidence",
    "confidence"
  ],
  "properties": {
    "number": {
      "type": "integer",
      "description": "1-indexed position in the source app list."
    },
    "name": { "type": "string" },
    "category": { "type": "string" },
    "hint_url": {
      "type": ["string", "null"],
      "description": "Optional starting URL from the source list, before research."
    },
    "one_liner": {
      "type": ["string", "null"],
      "description": "One-sentence summary of what the app does."
    },
    "auth": {
      "description": "How an already-registered developer authenticates API calls. Distinct from `access`.",
      "type": ["object", "null"],
      "required": ["method", "notes"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["oauth2", "api_key", "basic_auth", "jwt", "mtls", "saml", "none", "other", "unknown"]
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "access": {
      "description": "How a first-time developer obtains credentials: self-serve signup vs. gated behind sales/partner approval.",
      "type": ["object", "null"],
      "required": ["type", "notes"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["self_serve", "gated", "mixed", "unknown"]
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "api_surface": {
      "type": ["object", "null"],
      "required": ["rest", "graphql", "webhooks", "sdks", "notes"],
      "properties": {
        "rest": { "type": ["boolean", "null"] },
        "graphql": { "type": ["boolean", "null"] },
        "webhooks": { "type": ["boolean", "null"] },
        "sdks": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "mcp": {
      "description": "Whether a Model Context Protocol server exists for this app.",
      "type": ["object", "null"],
      "required": ["exists", "notes"],
      "properties": {
        "exists": { "type": ["boolean", "null"] },
        "url": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "buildability": {
      "type": ["object", "null"],
      "required": ["verdict", "reasoning"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["easy", "moderate", "hard", "blocked", "unknown"]
        },
        "reasoning": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Doc URLs backing the claims above. Every URL here must have been fetched successfully by the pipeline.",
      "items": {
        "type": "object",
        "required": ["url", "claim"],
        "properties": {
          "url": { "type": "string" },
          "claim": { "type": "string" },
          "accessed_at": { "type": ["string", "null"] }
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    }
  }
}
